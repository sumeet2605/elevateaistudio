# Backend reads this file after it is copied to .env.
ELEVATE_FRONTEND_ORIGIN=http://127.0.0.1:3000
ELEVATE_DATA_DIR=data
ELEVATE_MAX_UPLOAD_BYTES=536870912
ELEVATE_FFPROBE=ffprobe
ELEVATE_FFMPEG=ffmpeg

# Day 2 worker. Use a multilingual model with CPU INT8 on Apple Silicon.
ELEVATE_WHISPER_MODEL=small
ELEVATE_WHISPER_DEVICE=cpu
ELEVATE_WHISPER_COMPUTE_TYPE=int8
ELEVATE_WHISPER_THREADS=4
ELEVATE_WHISPER_BEAM_SIZE=5
ELEVATE_WHISPER_VAD=true
ELEVATE_WHISPER_VAD_MIN_SILENCE_MS=500
# Defaults to ELEVATE_DATA_DIR/models. Set an absolute path to share a model cache.
# ELEVATE_WHISPER_CACHE=

# Reserved for the director milestone. Keep credentials on the backend.
OPENAI_API_KEY=

# Day 4. Mock is deterministic and never calls the API.
ELEVATE_DIRECTOR_MODE=mock
ELEVATE_DIRECTOR_MODEL=gpt-5-mini
# Set current model rates in USD per million tokens for cost calculations.
# ELEVATE_DIRECTOR_INPUT_USD_PER_MTOK=
# ELEVATE_DIRECTOR_CACHED_USD_PER_MTOK=
# ELEVATE_DIRECTOR_OUTPUT_USD_PER_MTOK=
